# cp .env.example .env  then edit
# Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
# Password for the owner page https://your-domain/setup  (username can be anything)
ADMIN_PASSWORD=choose-a-strong-password
PUBLIC_BASE_URL=https://ourplay.example.com
DB_PATH=/data/ourplay.db
STUN_URL=stun:stun.l.google.com:19302
# Optional TURN relay (needed on strict networks / some mobile carriers)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
